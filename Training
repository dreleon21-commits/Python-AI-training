        "contacts = {}\n",
        "\n",
        "def add_contact(name, phone):\n",
        "  contacts[name] = phone\n",
        "  print(f\"Added {name}.\")\n",
        "\n",
        "def find_contact(name):\n",
        "  if name in contacts:\n",
        "    print(f\"{name}:{contacts[name]}\")\n",
        "  else:\n",
        "    print(\"Not Found\")\n",
        "\n",
        "def delete_contact(name):\n",
        "  if name in contacts:\n",
        "    del contacts[name]\n",
        "    print(f\"Deleted {name}.\")\n",
        "  else:\n",
        "    print(\"Not Found\")\n",
        "\n",
        "def show_all():\n",
        "  for name, phone in contacts.items():\n",
        "    print(f\"{name}-{phone}\")\n",
        "\n",
        "while True:\n",
        "  action = input(\"Action (add/find/delete/show/quit):\")\n",
        "  if action == \"add\":\n",
        "    add_contact(input(\"Name:\"), input(\"Phone:\"))\n",
        "  elif action == \"find\":\n",
        "    find_contact(input(\"Name:\"))\n",
        "  elif action == \"delete\":\n",
        "    delete_contact(input(\"Name:\"))\n",
        "  elif action == \"show\":\n",
        "    show_all()\n",
        "  elif action == \"quit\":\n",
        "    break\n",
        "  else:\n",
        "    print(\"Unknown Command.\")"
